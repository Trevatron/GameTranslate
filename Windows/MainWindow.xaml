<Window x:Class="GameTranslate.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameTranslate.Controls"
        Title="GameTranslate — Legendas em Tempo Real (EN → PT-BR)"
        Width="860"
        Height="700"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#11131A"
        Foreground="#F2F4F8"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#1A1D27"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A2F40"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFD800"/>
        <SolidColorBrush x:Key="MutedText" Color="#9AA3B5"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFD800"/>
            <Setter Property="Foreground" Value="#11131A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#252A38"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#363D52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3649"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202533"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12141C"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#32384C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFD800"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252A38"/>
            <Setter Property="Foreground" Value="#11131A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9AA3B5"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="#FFD800"/>
                                <Setter Property="Foreground" Value="#FFD800"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="#1D2130" BorderBrush="#FFD800" BorderThickness="1.8" Margin="0,0,12,0">
                    <TextBlock Text="GT" Foreground="#FFD800" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GameTranslate" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="OcrInfoText" Text="Camada de legenda amarela em tempo real (EN → PT-BR)" FontSize="12" Foreground="{StaticResource MutedText}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StealthBadge"
                        Background="#1E2B22"
                        BorderBrush="#2F6B43"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        ToolTip="A legenda amarela fica invisível para a captura OCR, permitindo ficar exatamente em cima do inglês sem interferência.">
                    <TextBlock x:Name="StealthBadgeText" Text="🛡 Sobreposição Inteligente" Foreground="#7EE2A0" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>

                <Border x:Name="StatusPill" Background="#2B2416" BorderBrush="#8A6C1F" BorderThickness="1" CornerRadius="12" Padding="12,4">
                    <TextBlock x:Name="StatusPillText" Text="● PAUSADO" Foreground="#FFD800" FontSize="12" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- MAIN ACTION BAR -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartStopButton" Style="{StaticResource PrimaryButton}" Content="▶  Iniciar Tradução (Alt+T)" Click="StartStopButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="SelectRegionButton" Style="{StaticResource SecondaryButton}" Content="🎯  Selecionar Área (Alt+R)" Click="SelectRegionButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="RepositionButton" Style="{StaticResource SecondaryButton}" Content="📐  Reposicionar Legenda" Click="RepositionButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="TestNowButton" Style="{StaticResource SecondaryButton}" Content="🧪  Testar OCR Agora" Click="TestNowButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="PreviewOnScreenButton" Style="{StaticResource SecondaryButton}" Content="👁  Prévia na Tela" Click="PreviewOnScreenButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- SETTINGS TABS -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8,14,14">
            <TabControl>
                <!-- TAB 1: SUBTITLE STYLE -->
                <TabItem Header="🎬 Estilo da Legenda">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,6,0">
                        <StackPanel>
                            <!-- Mini live preview of yellow cinema subtitle -->
                            <Border CornerRadius="8" Height="96" Margin="0,0,0,14" BorderBrush="#2E3548" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1C293B" Offset="0"/>
                                        <GradientStop Color="#2B3D3A" Offset="0.5"/>
                                        <GradientStop Color="#1F1B2E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="PRÉVIA DA LEGENDA SOBRE O JOGO"
                                               Foreground="#55FFFFFF"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Margin="10,6,0,0"/>
                                    <Border x:Name="MiniPreviewBackdrop"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#B8000000"
                                            CornerRadius="8"
                                            Padding="16,6">
                                        <controls:OutlinedTextBlock x:Name="MiniPreviewSubtitle"
                                                                    Text="Precisamos encontrar a chave antes do nascer do sol."
                                                                    FontFamily="Arial"
                                                                    FontSize="24"
                                                                    FontWeight="Bold"
                                                                    Fill="#FFD800"
                                                                    Stroke="Black"
                                                                    StrokeThickness="4"
                                                                    DropShadowEnabled="True"
                                                                    TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cor da Legenda (Presets Cinema/Séries)" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Tag="#FFD800" Click="ColorPreset_Click" Width="32" Height="28" Margin="0,0,6,0" Background="#FFD800" ToolTip="Amarelo Clássico de Séries (#FFD800)" Cursor="Hand"/>
                                        <Button Tag="#FFF200" Click="ColorPreset_Click" Width="32" Height="28" Margin="0,0,6,0" Background="#FFF200" ToolTip="Amarelo Vivo (#FFF200)" Cursor="Hand"/>
                                        <Button Tag="#FFBF00" Click="ColorPreset_Click" Width="32" Height="28" Margin="0,0,6,0" Background="#FFBF00" ToolTip="Amarelo Âmbar (#FFBF00)" Cursor="Hand"/>
                                        <Button Tag="#FFFFFF" Click="ColorPreset_Click" Width="32" Height="28" Margin="0,0,6,0" Background="#FFFFFF" ToolTip="Branco Cinema (#FFFFFF)" Cursor="Hand"/>
                                        <Button Tag="#5CE1E6" Click="ColorPreset_Click" Width="32" Height="28" Margin="0,0,8,0" Background="#5CE1E6" ToolTip="Ciano (#5CE1E6)" Cursor="Hand"/>
                                        <TextBox x:Name="ColorHexBox" Width="90" Text="#FFD800" TextChanged="StyleInput_Changed"/>
                                    </StackPanel>

                                    <TextBlock Text="Fonte" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FontFamilyCombo" SelectionChanged="StyleInput_Changed" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Arial"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Trebuchet MS"/>
                                        <ComboBoxItem Content="Verdana"/>
                                        <ComboBoxItem Content="Calibri"/>
                                        <ComboBoxItem Content="Tahoma"/>
                                        <ComboBoxItem Content="Consolas"/>
                                    </ComboBox>

                                    <DockPanel Margin="0,2,0,4">
                                        <TextBlock Text="Tamanho da Fonte" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock x:Name="FontSizeLabel" Text="32 px" Foreground="#FFD800" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="60" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleSlider_Changed" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="BoldCheck" Content="Negrito" IsChecked="True" Margin="0,0,18,0" Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed"/>
                                        <CheckBox x:Name="ItalicCheck" Content="Itálico" Margin="0,0,18,0" Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed"/>
                                        <CheckBox x:Name="ShadowCheck" Content="Sombra" IsChecked="True" Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Column -->
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Espessura do Contorno Preto" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock x:Name="OutlineLabel" Text="4.5 px" Foreground="#FFD800" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="OutlineSlider" Minimum="0" Maximum="8" Value="4.5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="StyleSlider_Changed" Margin="0,0,0,12"/>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Fundo Escuro (Cobre legenda em inglês)" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock x:Name="BackdropLabel" Text="72%" Foreground="#FFD800" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="BackdropSlider" Minimum="0" Maximum="100" Value="72" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="StyleSlider_Changed" Margin="0,0,0,4"/>
                                    <TextBlock Text="0% = só texto amarelo flutuando  •  75%+ = esconde o inglês por baixo" Foreground="#7A8499" FontSize="11" Margin="0,0,0,12"/>

                                    <TextBlock Text="Posição da Legenda na Tela" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,4"/>
                                    <ComboBox x:Name="OverlayPosCombo" SelectionChanged="StyleInput_Changed" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Rodapé da Tela — Estilo Séries (Padrão)" Tag="BottomOfScreen"/>
                                        <ComboBoxItem Content="Rodapé da Janela/Área Capturada" Tag="BottomOfCaptureRegion"/>
                                        <ComboBoxItem Content="Sobre a Área Capturada" Tag="OverCaptureRegion"/>
                                        <ComboBoxItem Content="Posição Livre (arrastar manualmente)" Tag="CustomFree"/>
                                    </ComboBox>

                                    <CheckBox x:Name="CompactMenuCheck"
                                              Content="Compactar listas de menu em uma linha (ex: Bondade • Mente)"
                                              IsChecked="True"
                                              Checked="StyleCheck_Changed"
                                              Unchecked="StyleCheck_Changed"/>

                                    <CheckBox x:Name="ShowOriginalCheck"
                                              Content="Mostrar texto original (inglês) pequeno acima"
                                              Checked="StyleCheck_Changed"
                                              Unchecked="StyleCheck_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: CAPTURE & OCR -->
                <TabItem Header="👁 Captura e OCR">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Área de Captura Atual" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                <Border Background="#12141C" BorderBrush="#2E3548" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock x:Name="RegionSummaryText" Text="Não definida" Foreground="#FFD800" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="Rodapé 16:9" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11.5" HorizontalAlignment="Right" Click="PresetBottomRegion_Click"/>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Filtro de Imagem para OCR" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,4"/>
                                <ComboBox x:Name="OcrFilterCombo" SelectionChanged="OcrSetting_Changed" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Auto (Recomendado — contraste equilibrado)" Tag="Auto"/>
                                    <ComboBoxItem Content="Texto Branco/Amarelo (Isola legendas em jogos 3D)" Tag="WhiteYellowText"/>
                                    <ComboBoxItem Content="Alto Contraste (Binarização adaptativa)" Tag="HighContrast"/>
                                    <ComboBoxItem Content="Original (Apenas ampliação 2x)" Tag="Original"/>
                                </ComboBox>

                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock Text="Sensibilidade de Brilho (filtro Texto Claro)" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                    <TextBlock x:Name="LumaLabel" Text="175" Foreground="#FFD800" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="LumaSlider" Minimum="110" Maximum="240" Value="175" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OcrSlider_Changed" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock Text="Intervalo de Verificação (menor = mais rápido)" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                    <TextBlock x:Name="IntervalLabel" Text="140 ms" Foreground="#FFD800" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="IntervalSlider" Minimum="100" Maximum="1000" Value="140" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OcrSlider_Changed" Margin="0,0,0,10"/>

                                <TextBlock Text="Motor OCR Nativo do Windows" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,4"/>
                                <ComboBox x:Name="OcrLangCombo" SelectionChanged="OcrSetting_Changed" Margin="0,0,0,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <CheckBox x:Name="ExcludeCaptureCheck"
                                          Content="Ocultar legenda da captura (WDA_EXCLUDEFROMCAPTURE)"
                                          IsChecked="True"
                                          Checked="OcrCheck_Changed"
                                          Unchecked="OcrCheck_Changed"/>
                                <TextBlock Text="Permite que a legenda fique por cima do jogo sem que o OCR leia a própria tradução."
                                           Foreground="#7A8499" FontSize="11.5" TextWrapping="Wrap" Margin="22,0,0,6"/>

                                <CheckBox x:Name="AutoExcludeTitleBarCheck"
                                          Content="Ignorar barra de título da janela automaticamente"
                                          IsChecked="True"
                                          Checked="OcrCheck_Changed"
                                          Unchecked="OcrCheck_Changed"/>

                                <CheckBox x:Name="AutoCorrectOcrCheck"
                                          Content="Corrigir erros de OCR em fontes pixeladas/estilizadas"
                                          IsChecked="True"
                                          Checked="OcrCheck_Changed"
                                          Unchecked="OcrCheck_Changed"/>

                                <CheckBox x:Name="MinimizeToTrayCheck"
                                          Content="Minimizar para a bandeja (System Tray) ao fechar"
                                          IsChecked="True"
                                          Checked="OcrCheck_Changed"
                                          Unchecked="OcrCheck_Changed"/>

                                <TextBlock Text="Última Imagem Processada pelo OCR (clique em 'Testar OCR Agora')"
                                           Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,6"/>
                                <Border Background="#0B0D12" BorderBrush="#2E3548" BorderThickness="1" CornerRadius="6" Height="130">
                                    <Grid>
                                        <TextBlock x:Name="PreviewPlaceholderText"
                                                   Text="Clique em 'Testar OCR Agora' para ver exatamente o que o OCR enxerga"
                                                   Foreground="#5A6478"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="16"/>
                                        <Image x:Name="DiagnosticPreviewImage" Stretch="Uniform" Margin="4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: TRANSLATOR -->
                <TabItem Header="🌐 Tradutor">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,6,0">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Serviço de Tradução" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ProviderCombo" SelectionChanged="TranslatorSetting_Changed" Margin="0,0,0,6">
                                <ComboBoxItem Content="Híbrido Inteligente (Google + Reverso + Bing LLM — Recomendado)" Tag="HybridSmart"/>
                                <ComboBoxItem Content="Google Tradutor (Ultra-rápido, sem chave)" Tag="GoogleFree"/>
                                <ComboBoxItem Content="Reverso Neural (Diálogos naturais, sem chave)" Tag="ReversoFree"/>
                                <ComboBoxItem Content="Bing Tradutor (Neural / LLM, sem chave)" Tag="BingFree"/>
                                <ComboBoxItem Content="MyMemory (Alternativa grátis)" Tag="MyMemoryFree"/>
                                <ComboBoxItem Content="DeepL API (Requer chave grátis/pro)" Tag="DeepLApi"/>
                                <ComboBoxItem Content="OpenAI / Ollama Local (Endpoint compatível)" Tag="OpenAiCompatible"/>
                            </ComboBox>
                            <TextBlock Text="O modo Híbrido exibe a resposta mais rápida na hora e combina múltiplos motores neurais em paralelo para escolher a tradução mais natural em PT-BR."
                                       Foreground="#7A8499" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <CheckBox x:Name="GamingGlossaryCheck"
                                      Content="Usar Glossário Gamer (0 ms — Party → Grupo, Save → Salvar, Back → Voltar...)"
                                      IsChecked="True"
                                      Checked="StyleCheck_Changed"
                                      Unchecked="StyleCheck_Changed"
                                      Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Idioma da Legenda do Jogo" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="SourceLangCombo" SelectionChanged="TranslatorSetting_Changed">
                                        <ComboBoxItem Content="Inglês (en)" Tag="en"/>
                                        <ComboBoxItem Content="Detectar Automaticamente (auto)" Tag="auto"/>
                                        <ComboBoxItem Content="Espanhol (es)" Tag="es"/>
                                        <ComboBoxItem Content="Japonês (ja)" Tag="ja"/>
                                        <ComboBoxItem Content="Francês (fr)" Tag="fr"/>
                                        <ComboBoxItem Content="Alemão (de)" Tag="de"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Traduzir Para" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="TargetLangCombo" SelectionChanged="TranslatorSetting_Changed">
                                        <ComboBoxItem Content="Português do Brasil (pt-BR)" Tag="pt-BR"/>
                                        <ComboBoxItem Content="Português de Portugal (pt-PT)" Tag="pt-PT"/>
                                        <ComboBoxItem Content="Espanhol (es)" Tag="es"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- DeepL Config -->
                            <StackPanel x:Name="DeepLPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="Chave API DeepL (chave gratuita termina com :fx)" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="DeepLKeyBox" TextChanged="TranslatorText_Changed"/>
                            </StackPanel>

                            <!-- OpenAI / Ollama Config -->
                            <StackPanel x:Name="OpenAiPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="URL do Endpoint (ex: http://localhost:11434/v1/chat/completions)" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="OpenAiEndpointBox" TextChanged="TranslatorText_Changed" Margin="0,0,0,8"/>

                                <TextBlock Text="Modelo (ex: llama3.2, qwen2.5, gpt-4o-mini)" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="OpenAiModelBox" TextChanged="TranslatorText_Changed" Margin="0,0,0,8"/>

                                <TextBlock Text="API Key (opcional para Ollama local)" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="OpenAiKeyBox" TextChanged="TranslatorText_Changed"/>
                            </StackPanel>

                            <Button Content="🗑  Limpar Cache de Traduções" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ClearCacheButton_Click" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: HOTKEYS & TIPS -->
                <TabItem Header="⌨ Atalhos e Dicas">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,6,0">
                        <StackPanel>
                            <TextBlock Text="Atalhos Globais (funcionam mesmo dentro do jogo)" Foreground="#FFD800" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <Border Background="#12141C" BorderBrush="#2A2F40" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Alt + T" Foreground="#FFD800" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Iniciar ou Pausar a tradução em tempo real"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt + H" Foreground="#FFD800" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Mostrar ou Ocultar a legenda amarela na tela"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Alt + R" Foreground="#FFD800" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Selecionar novamente a área da legenda do jogo"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Alt + O" Foreground="#FFD800" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Forçar leitura e tradução instantânea"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Dicas para Melhor Experiência nos Jogos" Foreground="#FFD800" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#D4DAE6" LineHeight="21">
                                • <Bold>Use o jogo em "Janela Sem Bordas" (Borderless Fullscreen):</Bold> No Windows, janelas em Tela Cheia Exclusiva (Exclusive Fullscreen) bloqueiam qualquer camada por cima. Janela Sem Bordas tem o mesmo visual em tela cheia e deixa a legenda amarela aparecer perfeitamente.<LineBreak/>
                                • <Bold>100% Seguro contra Anti-Cheat:</Bold> O GameTranslate não injeta nenhuma DLL no processo do jogo — ele usa apenas captura nativa do Windows e uma janela transparente por cima.<LineBreak/>
                                • <Bold>Jogos 3D com fundo muito colorido:</Bold> Se o OCR errar letras quando o fundo do jogo muda muito, vá na aba <Bold>Captura e OCR</Bold> e mude o filtro para <Bold>Texto Branco/Amarelo</Bold>.<LineBreak/>
                                • <Bold>Pacote OCR em Inglês (opcional):</Bold> O GameTranslate já funciona mesmo com o Windows apenas em Português (pt-BR). Se quiser precisão ainda maior em palavras difíceis em inglês, basta ter o idioma Inglês adicionado no Windows.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

