<Window x:Class="GameTranslate.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Área da Legenda"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Canvas x:Name="OverlayCanvas" Background="#01000000">
        <!-- Dimmed backdrop with transparent cutout for selected region -->
        <Path x:Name="DimPath" Fill="#99000000" IsHitTestVisible="False"/>

        <!-- Golden selection border -->
        <Border x:Name="SelectionBox"
                Visibility="Collapsed"
                BorderBrush="#FFD800"
                BorderThickness="2.5"
                Background="Transparent"
                IsHitTestVisible="False"/>

        <!-- Live pixel dimension badge -->
        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#E6141418"
                BorderBrush="#FFD800"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,4"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeBadgeText"
                       Foreground="#FFD800"
                       FontSize="13"
                       FontWeight="Bold"
                       Text="0 x 0 px"/>
        </Border>

        <!-- Top instruction banner -->
        <Border x:Name="InstructionBanner"
                Background="#EA14141C"
                BorderBrush="#FFD800"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="20,10"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯  Arraste sobre a área da legenda  •  ou CLIQUE na janela do jogo para capturá-la sem a barra de título   "
                           Foreground="White"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="#33FFD800" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="ESC para cancelar" Foreground="#FFD800" FontSize="13" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
